# while循环
#include <stdio.h>
int main(void){
    int i;
    int sum = 0;
        i = 0 ;
    
        while ( i <=100 ){ 
        sum = sum + i ;
        i++ ;
    }
    printf("sum=%d\n" ,sum);
    return 0 ;
}

# for循环 成绩
#include <stdio.h>
#include <windows.h>
int main(){
    SetConsoleOutputCP(65001);
    float score;
    printf("请输入你的成绩:");
    scanf("%f", &score);

    if (score >= 90 && score <= 100) {
        printf("成绩优秀\n");
    } else if (score >= 80 && score < 90) {
        printf("成绩良好\n");
    } else if (score >= 60 && score < 80) {
        printf("成绩及格\n");
    } else if (score >= 0 && score < 60) {
        printf("下次加油！\n");
    }

    return 0;
}
# for 循环1-100 列举 1-100的和 将 i = i改成i = i + 1 
#include <stdio.h>
int main (){
    int i;
    for (i = 1; i <= 100; i++){
        i = i ;
        printf("i = %d\n", i);
    }
    return 0 ;
}
#99乘法表
#include <stdio.h>
int main(){
    int i;
    int j;
    for (i = 1 ;i<= 9; i++){
        for (j = 1; j<= i ; j ++){
            printf(" %d*%d=%d",i ,j ,i *j);
        }
        printf("\n");

    }
    return 0 ;
}
#判断是否为正负数
#include <stdio.h>
int main(void){
    int num;
    printf("Enter a number:");/*printf("enter a number:%d\n", num);这里的 %d 是用来格式化输出整数的占位符。因为你此时还没有给 num 赋值，printf 会尝试把 num 中内存里随机的乱码值（在 C 语言中称为“垃圾值”）打印出来。这会导致你的终端显示一行带有奇怪数字的提示。*/
    scanf("%d", &num);
    
    if (num > 0){
        printf("positive\n");
    }else if (num < 0){
        printf("negative\n");
    }else if (num == 0){
        printf("zero\n");
        }
        return 0;
        }
        
